# Run commands from api/. Values fall back to ../.env if absent here.
# Set this only to use a different database than the Next.js project.
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/pawplan
API_ADDR=127.0.0.1:8080
FRONTEND_ORIGIN=http://localhost:3000
APP_ENV=development
# Use none only for a cross-site deployment with HTTPS and APP_ENV=production.
COOKIE_SAME_SITE=lax
# Set only when a trusted reverse proxy supplies the real client IP.
# TRUSTED_PROXIES=127.0.0.1,::1
